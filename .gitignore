# 默认忽略所有
*

# 保留 gitignore
!.gitignore
!README.md
!README.en.md
!LICENSE
!CLAUDE.md
!AGENTS.md

# 保留 mise 版本配置
!mise.toml

# 保留 cfg / assets 目录
!assets
!assets/**
!cfg/

# cfg 下默认全部忽略
cfg/*

# 保留 autoexec
!cfg/autoexec.cfg

# 保留 config 整个目录
!cfg/config/
!cfg/config/**

# 保留设计文档（superpowers specs）
!docs/
!docs/**

# 保留 GitHub Pages 网站源码（Vite + React）
!site/
!site/**
site/node_modules/
site/dist/
